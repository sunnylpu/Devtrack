# ───────────────────────────────────────────
# DevTrack Pro – Backend Environment Variables
# Copy this file to .env and fill in your values
# ───────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5001

# MongoDB
MONGO_URI=mongodb://localhost:27017/devtrack_pro

# JWT Secrets (generate strong random strings!)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS & redirects)
FRONTEND_URL=http://localhost:5173

# GitHub OAuth (optional – for GitHub integration)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5001/api/github/callback

# OpenAI (optional – enables AI features, falls back to mock)
OPENAI_API_KEY=

# Redis (optional – for BullMQ background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email / SMTP (optional – for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=DevTrack Pro <noreply@devtrack.pro>
